"""
Patch for agent/prompt_builder.py — adds hybrid per-message skill retrieval.

Apply this patch to the upstream prompt_builder.py. It:
  1. Adds `query_text: str | None = None` to build_skills_system_prompt().
  2. After skills_by_category is assembled, runs hybrid retrieval when a
     query is present and skills.semantic_search.enabled is true.
  3. In the rendering loop, demotes non-featured skills to a names-only
     line so the agent can still reach them via skill_view() — no info lost.
  4. Adds query_text[:128] to the in-process LRU cache key.

--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ def build_skills_system_prompt(
-def build_skills_system_prompt(
+def build_skills_system_prompt(  # noqa: C901
     available_tools: "set[str] | None" = None,
     available_toolsets: "set[str] | None" = None,
     compact_categories: "frozenset[str] | None" = None,
+    query_text: "str | None" = None,
 ) -> str:
     \"\"\"Build a compact skill index for the system prompt.

+    When *query_text* is provided and ``skills.semantic_search.enabled`` is
+    true, only the top-k most relevant skills (ranked by hybrid BM25 + optional
+    dense re-ranking, fused with RRF) are shown with full descriptions. All
+    other skills are listed by name only so the agent can still load any of
+    them with ``skill_view(name)`` — no skills are ever hidden.
+
+    When fewer skills exist than ``top_k``, or when retrieval is disabled /
+    fails, the full-index rendering path is used unchanged.
+
     Two-layer cache:
       ...existing docstring unchanged...
     \"\"\"

@@ cache key — add query_text
     cache_key = (
         str(skills_dir),
         tuple(str(d) for d in external_dirs),
         tuple(sorted(str(t) for t in (available_tools or set()))),
         tuple(sorted(str(ts) for ts in (available_toolsets or set()))),
         _platform_hint,
         tuple(sorted(disabled)),
         tuple(sorted(compact_categories or ())),
+        (query_text or "")[:128],   # per-query cache; 128-char prefix is enough
     )

@@ after skills_by_category and external dirs are fully built
     # ── Hybrid per-message skill retrieval ───────────────────────────────
     # When a query is present, rank skills by relevance to the user's message
     # and split into two tiers:
     #   • featured_skills  → shown with full "name: description" lines
     #   • everyone else    → shown as names-only (agent can still skill_view)
     # Falls back to full-index rendering on any error or when disabled.
+    featured_skills: "set[str] | None" = None
+    if query_text:
+        try:
+            from hermes_cli.config import load_config
+            _cfg = load_config()
+            _ss: dict = (
+                (_cfg.get("skills") or {}).get("semantic_search") or {}
+            )
+            if _ss.get("enabled", True):
+                _top_k = max(1, int(_ss.get("top_k", 5)))
+                _all_skills = [
+                    {"name": name, "description": desc}
+                    for cat_skills in skills_by_category.values()
+                    for name, desc in cat_skills
+                ]
+                if len(_all_skills) > _top_k:
+                    from agent.skill_retrieval import retrieve_skills
+                    _emb_cfg = _ss if _ss.get("embedding_model") else None
+                    featured_skills = retrieve_skills(
+                        query_text,
+                        _all_skills,
+                        top_k=_top_k,
+                        embedding_cfg=_emb_cfg,
+                    )
+        except Exception as _exc:
+            logger.debug(
+                "Skill retrieval failed, using full index: %s", _exc
+            )
+            featured_skills = None

@@ rendering loop — demote non-featured skills to names-only
         index_lines = []
+        non_featured_names: list[str] = []
         for category in sorted(skills_by_category.keys()):
             # Deduplicate and sort skills within each category
             seen = set()
             if category in demoted:
                 names = sorted({name for name, _ in skills_by_category[category]})
                 index_lines.append(f"  {category} [names only]: {', '.join(names)}")
                 continue
             cat_desc = category_descriptions.get(category, "")
             if cat_desc:
                 index_lines.append(f"  {category}: {cat_desc}")
             else:
                 index_lines.append(f"  {category}:")
+            has_featured_in_category = False
             for name, desc in sorted(skills_by_category[category], key=lambda x: x[0]):
                 if name in seen:
                     continue
                 seen.add(name)
+                # Retrieval ran: demote non-featured skills to the names-only bucket
+                if featured_skills is not None and name not in featured_skills:
+                    non_featured_names.append(name)
+                    continue
+                has_featured_in_category = True
                 if desc:
                     index_lines.append(f"    - {name}: {desc}")
                 else:
                     index_lines.append(f"    - {name}")
+            # Remove the category header if retrieval demoted all its skills
+            if featured_skills is not None and not has_featured_in_category:
+                # Pop the category header we just appended (last item)
+                index_lines.pop()

+        # Non-featured skills: names-only footer so the agent can skill_view() them
+        if non_featured_names:
+            index_lines.append(
+                "  [other skills, names only]: "
+                + ", ".join(sorted(non_featured_names))
+            )
+            index_lines.append(
+                "  (load any with skill_view(name) — only the most relevant "
+                "skills for this turn are shown with full descriptions above)"
+            )
"""
